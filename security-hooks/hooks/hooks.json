  "description": "Makes grep and rg skip secret file names in Claude sessions",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/install-grep-shim.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
